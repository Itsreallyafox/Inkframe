# Inkframe systemd unit.  install.sh --update copies it to
# /etc/systemd/system/inkframe.service whenever it changes (a push that
# touches this file triggers that).  See docs/DEPLOY.md.
#
# No ProtectSystem=/PrivateDevices= style hardening: it would hide
# /dev/spidev0.0 and /dev/gpiochip* from the panel driver.

[Unit]
Description=Inkframe e-ink photo frame
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=inkframe
Group=inkframe
SupplementaryGroups=spi gpio
WorkingDirectory=/opt/inkframe/app
# epd drives the real panel; set to mock to develop without touching it
Environment=INKFRAME_DISPLAY=epd
Environment=INKFRAME_DATA=/opt/inkframe/data
Environment=INKFRAME_HOST=0.0.0.0
Environment=INKFRAME_PORT=80
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/inkframe/.venv/bin/python -m inkframe
Restart=always
RestartSec=3
# port 80 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# a panel refresh may be in flight when the stop arrives (~19 s, about 40 s
# with clear_before_refresh); the app lets it finish (up to 100 s,
# SCHEDULER_STOP_TIMEOUT in inkframe/app.py) and sleeps the panel, so give
# it well over that before SIGKILL
KillSignal=SIGTERM
TimeoutStopSec=150
# Crash safety net: if the process dies without its own power-down path
# (SIGKILL, OOM), a released GPIO line keeps its last level and the HAT's
# 5 V rail (BCM18 = PWR) could stay on.  Drive RST (17), PWR (18) and DC (25)
# low as outputs after every stop; harmless after a clean shutdown.
# pinctrl is in raspi-utils-core and works for the gpio group via /dev/gpiomem.
ExecStopPost=-/usr/bin/pinctrl set 17,18,25 op dl

[Install]
WantedBy=multi-user.target
